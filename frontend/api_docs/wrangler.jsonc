{
  // Static-assets Worker for storyteller-docs.artcraft.team: the Swagger UI page plus the
  // storyteller-web OpenAPI document. There is no server-side code and no build
  // here — both files are committed under public/ because the document is
  // generated by a Rust binary that Workers Builds cannot run (see README.md).
  // Deploy from the repository root with ARTCRAFT_APP=storyteller-docs (see
  // script/website/cloudflare_app.sh).
  "name": "storyteller-docs",
  "compatibility_date": "2026-11-18",
  "assets": {
    // Assets-only Worker: no `main` script, so an assets binding is not allowed.
    "directory": "./public"
  },
  "routes": [
    {
      "pattern": "storyteller-docs.artcraft.team",
      "custom_domain": true
    }
  ],
  "previews": {}
}
