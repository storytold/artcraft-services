# inference-job default .env configurations (these can be overridden with k8s)

SMTP_RELAY="smtp.gmail.com"
# SMTP_USERNAME="noreply@storyteller.ai"
SMTP_USERNAME="accounts@storyteller.ai"
# SMTP_PASSWORD is a secret. Set it in the untracked (gitignored)
# `email-sender-job.development-secrets.env` next to this file, or in the environment.

# NB: To not step on storyteller-web (the main API gateway)
HTTP_BIND_ADDRESS=0.0.0.0:11223
