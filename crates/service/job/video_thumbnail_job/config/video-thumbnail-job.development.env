# default .env configurations (these can be overridden with k8s)

# Development
SERVER_ENVIRONMENT='development'

# Don't collide with storyteller-web in development
HTTP_BIND_ADDRESS=0.0.0.0:13339

# Limit whole thumbnail attempts, including FFmpeg and downloads.
VIDEO_THUMBNAIL_CONCURRENCY=1
VIDEO_THUMBNAIL_POLL_INTERVAL_MILLIS=5000
