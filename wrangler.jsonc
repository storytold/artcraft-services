{
  "name": "artcraft-services",
  "compatibility_date": "2026-11-06",
  "main": "frontend/apps/artcraft-website-next/worker/index.mjs",
  "build": {
    "command": "test -f frontend/apps/artcraft-website-next/out/index.html || npm run build"
  },
  "assets": {
    "directory": "./frontend/apps/artcraft-website-next/out",
    "binding": "ASSETS",
    "run_worker_first": [
      "/checkout_success",
      "/checkout_cancel",
      "/portal_closed",
      "/apps/loopcraft",
      "/apps/drawcraft",
      "/apps/printcraft",
      "/images/apps/loopcraft/*",
      "/images/apps/printcraft/*",
      "/tutorials/*",
      "/apps/*/*-oci.flatpakref",
      "/artcraft-oci.flatpakrepo",
      "/index/*",
      "/keys/*",
      "/oci-signatures/*",
      "/apt/*",
      "/rpm/*",
      "/arch/*",
      "/media",
      "/media/*"
    ]
  },
  "previews": {}
}
